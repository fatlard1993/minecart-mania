{
  "schemaVersion": 1,
  "id": "minecart-mania-justfatlard",
  "version": "${version}",
  "name": "Minecart Mania",
  "description": "Faster rails, chained carts, and carts that lay track and dig",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/minecart-mania"
  },
  "license": "MIT",
  "icon": "assets/minecart-mania-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.minecart_mania.Main"
    ]
  },
  "mixins": [
    "minecart-mania-justfatlard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": ">=15.40.0"
  },
  "suggests": {
    "block-tip": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://github.com/sponsors/fatlard1993"
      }
    }
  }
}
